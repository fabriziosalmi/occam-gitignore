.DS_Store
.idea/
# Editor state is personal, but these VS Code files are meant to be shared.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
Thumbs.db
*.bak
*.swp
*.tmp
*~

# Environment files & secrets.
# Every ecosystem can carry these, so they live in `common` (not tied to any
# language). This keeps credentials out of git regardless of the detected stack.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
